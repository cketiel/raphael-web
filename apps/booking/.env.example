# Local development: copy to .env.local (never committed) and fill in.
# In Azure these same names are App Service "Application settings" (the equivalent of
# appsettings.json in Desktop). They are read when the server starts: changing one needs a
# restart, never a rebuild.

# Which Raphael.Api this server talks to: dev | prod. There is no default on purpose.
RAPHAEL_API_ENV=dev

# Encrypts the session cookie. At least 32 random characters, different per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google Maps browser key (Maps JavaScript + Places New), restricted by HTTP referrer to this
# site's domain. Public by Google's design; never put the server key here.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID for Advanced Markers. Empty uses Google's DEMO_MAP_ID, valid for development only.
GOOGLE_MAPS_MAP_ID=
